@model IEnumerable<QuanLiPhongTro.Models.ToaNha>
@{
    ViewData["Title"] = "Danh sách Tòa Nhà";
}

<style>
    .building-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 2rem;
        background: white;
        border-radius: 8px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
    }

    .building-title {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: #248f55;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #a5d6a7;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1.5rem;
    }

    .table thead th {
        background-color: #248f55;
        color: white;
        padding: 12px 15px;
        text-align: left;
    }

    .table tbody tr {
        border-bottom: 1px solid #e0e0e0;
        transition: background-color 0.3s;
    }

    .table tbody tr:nth-child(even) {
        background-color: #f5f5f5;
    }

    .table tbody tr:hover {
        background-color: #e8f5e9;
    }

    .table td {
        padding: 12px 15px;
    }

    .btn-add {
        background-color: #248f55;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        transition: all 0.3s;
    }

    .btn-add:hover {
            background-color: #39e488;
    }

    .btn-action {
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        margin: 0 0.25rem;
    }

    .alert {
        padding: 1rem;
        border-radius: 4px;
        margin-bottom: 1.5rem;
    }

    .alert-success {
        background-color: #e8f5e9;
        border-color: #c8e6c9;
        color: #2e7d32;
    }

    .alert-danger {
        background-color: #ffebee;
        border-color: #ffcdd2;
        color: #d32f2f;
    }
</style>

<div class="building-container">
    <h2 class="building-title">@ViewData["Title"]</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        </div>
    }

    <a asp-action="Create" class="btn btn-success btn-add mb-3">
        <i class="bi bi-plus-circle"></i> Thêm Tòa Nhà
    </a>

    <table class="table">
        <thead>
            <tr>
                <th>Mã Tòa Nhà</th>
                <th>Tên Tòa Nhà</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.TenToa</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-success btn-action">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-action">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>    
</div>

@section Scripts {
   @*  <!-- Thêm Font Awesome cho icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <!-- Hoặc Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css"> *@
}