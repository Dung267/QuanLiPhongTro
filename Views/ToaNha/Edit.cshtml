@model QuanLiPhongTro.Models.ToaNha
@{
    ViewData["Title"] = "Chỉnh sửa Tòa Nhà";
}
<style>
    .create-building-container {
        max-width: 600px;
        margin: 2rem auto;
        padding: 2rem;
        background: white;
        border-radius: 8px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
    }

    .create-building-title {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: #2e7d32;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #a5d6a7;
    }

    .form-label {
        font-weight: 500;
        color: #2e7d32;
        margin-bottom: 0.5rem;
    }

    .form-control {
        border: 1px solid #a5d6a7;
        padding: 0.75rem;
        border-radius: 6px;
    }

    .form-control:focus {
        border-color: #4caf50;
        box-shadow: 0 0 0 0.25rem rgba(76, 175, 80, 0.25);
    }

    .btn-submit {
        background-color: #4caf50;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        transition: all 0.3s;
    }

    .btn-submit:hover {
        background-color: #388e3c;
    }

    .btn-back {
        background-color: #6c757d;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        transition: all 0.3s;
    }

    .btn-back:hover {
        background-color: #5a6268;
    }

    .alert {
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
    }

    .alert-danger {
        background-color: #ffebee;
        border-color: #ffcdd2;
        color: #d32f2f;
    }

    .alert-warning {
        background-color: #fff8e1;
        border-color: #ffe0b2;
        color: #ff6f00;
    }

    .text-danger {
        color: #d32f2f;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }
</style>

<div class="create-building-container">
    <h2 class="create-building-title">@ViewData["Title"]</h2>
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i> Vui lòng kiểm tra lại thông tin nhập
        </div>

        <div class="mb-4">
            <label asp-for="Id" class="form-label">Mã Tòa Nhà</label>
            <input asp-for="Id" class="form-control" placeholder="T01, TN10..." disabled /> <!-- ID không được chỉnh sửa -->
            <span asp-validation-for="Id" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="TenToa" class="form-label">Tên Tòa Nhà</label>
            <input asp-for="TenToa" class="form-control" placeholder="Nhập tên tòa nhà" />
            <span asp-validation-for="TenToa" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-submit">
                <i class="bi bi-save"></i> Lưu
            </button>
            <a asp-action="Index" class="btn btn-back">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
