@{
    ViewData["Title"] = "Trang chủ Chủ trọ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #248F55;
        --primary-light: #a5d6a7;
        --primary-hover: #388e3c;
        --sidebar-bg: #e9f4ee;
        --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
        --section-title: #1b5e20;
    }

    body {
        background-color: #f5f5f5;
    }

    .sidebar {
        background-color: var(--sidebar-bg);
        border-right: 1px solid #e0e0e0;
        height: 100vh;
        position: sticky;
        top: 0;
    }

    .section-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--section-title);
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        padding-left: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .sidebar .nav-link {
        border-radius: 6px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.25rem;
        color: #417338;
        display: flex;
        align-items: center;
        transition: all 0.3s ease;
    }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: var(--primary-color) !important;
            color: white !important;
        }

        .nav-link i {
            margin-right: 0.75rem;
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
        }

    .dropdown-toggle::after {
        margin-left: auto;
    }

    .nav .collapse .nav-link {
        padding-left: 2rem;
        font-size: 0.95rem;
    }

    .main-content {
        padding: 2rem;
        background-color: white;
        min-height: calc(100vh - 56px);
    }

    .welcome-title {
        color: var(--primary-color);
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .welcome-subtitle {
        color: #616161;
        margin-bottom: 2rem;
    }

    .card {
        border: none;
        border-radius: 10px;
        box-shadow: var(--card-shadow);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
        border-left: 4px solid var(--primary-color);
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        }

    .card-title {
        color: var(--primary-color);
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    .card-body {
        padding: 1.5rem;
    }

    .card-text {
        color: #616161;
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--primary-color);
        margin-top: 0.5rem;
    }

    .bi {
        font-size: 1.2rem;
        margin-right: 0.5rem;
    }

    .dropdown-menu {
        border: none;
        box-shadow: var(--card-shadow);
    }
</style>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar p-3">
            <div class="position-sticky">
                <h6 class="section-title">Quản lý & vận hành</h6>

                <!-- Danh mục dữ liệu -->
                <div class="nav-item mb-2">
                    <a class="nav-link dropdown-toggle" data-bs-toggle="collapse" href="#danhMucCollapse" role="button">
                        <i class="bi bi-folder"></i> Danh mục dữ liệu
                    </a>
                    <div class="collapse ps-2" id="danhMucCollapse">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ToaNha" asp-action="Index">
                                    <i class="bi bi-building"></i> Tòa nhà
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Phong" asp-action="Index">
                                    <i class="bi bi-door-open"></i> Căn hộ/Phòng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DichVu" asp-action="Index">
                                    <i class="bi bi-droplet"></i> Dịch vụ
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Khách hàng -->
                <div class="nav-item mb-2">
                    <a class="nav-link dropdown-toggle" data-bs-toggle="collapse" href="#khachHangCollapse" role="button">
                        <i class="bi bi-people"></i> Khách hàng
                    </a>
                    <div class="collapse ps-2" id="khachHangCollapse">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="HopDong" asp-action="DanhSach">
                                    <i class="bi bi-file-earmark-text"></i> Hợp đồng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="SuDungDichVu" asp-action="Index">
                                    <i class="bi bi-boxes"></i> Sử dụng dịch vụ
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Sự cố -->
                <div class="nav-item mb-2">
                    <a class="nav-link" asp-controller="SuCo_ChuTro" asp-action="DanhSachSuCo">
                        <i class="bi bi-tools"></i> Sự cố
                    </a>
                </div>

                <h6 class="section-title">Báo cáo tài chính</h6>

                <!-- Thống kê -->
                <div class="nav-item mb-2">
                    <a class="nav-link dropdown-toggle" data-bs-toggle="collapse" href="#baoCaoCollapse" role="button">
                        <i class="bi bi-bar-chart-line"></i> Thống kê - Báo cáo
                    </a>
                    <div class="collapse ps-2" id="baoCaoCollapse">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="BaoCao" asp-action="BaoCaoTaiChinh">
                                    <i class="bi bi-graph-up-arrow"></i> Báo cáo Tài chính
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="QLThanhToan" asp-action="Index">
                                    <i class="bi bi-cash-stack"></i> Thanh toán
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
            <h2 class="welcome-title"><i class="bi bi-house-heart"></i> Chào mừng trở lại, Chủ trọ!</h2>
            <p class="welcome-subtitle">Quản lý hệ thống nhà trọ của bạn một cách hiệu quả và dễ dàng</p>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-building"></i> Tổng số tòa nhà</h5>
                            <p class="card-text">Số lượng tòa nhà đang quản lý</p>
                            <div class="stat-value">5</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-door-open"></i> Tổng số phòng</h5>
                            <p class="card-text">Tổng số phòng đang cho thuê</p>
                            <div class="stat-value">32</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-cash-coin"></i> Doanh thu tháng</h5>
                            <p class="card-text">Tổng doanh thu tháng này</p>
                            <div class="stat-value">85.000.000đ</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-check-circle"></i> Phòng đã thuê</h5>
                            <p class="card-text">Số phòng đã có người thuê</p>
                            <div class="stat-value">28</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-exclamation-triangle"></i> Sự cố chưa xử lý</h5>
                            <p class="card-text">Sự cố cần được giải quyết</p>
                            <div class="stat-value">3</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-people"></i> Khách thuê</h5>
                            <p class="card-text">Tổng số khách đang thuê</p>
                            <div class="stat-value">45</div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

@* <!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css"> *@