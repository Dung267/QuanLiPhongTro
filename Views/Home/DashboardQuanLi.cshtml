@{
    ViewData["Title"] = "Trang chủ Quản lý";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #248F55;
        --primary-light: #a5d6a7;
        --primary-hover: #388e3c;
        --sidebar-bg: #e9f4ee;
        --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
        --section-title: #1b5e20;
    }

    body {
        background-color: #f5f5f5;
    }
   

    .sidebar {
        background-color: var(--sidebar-bg);
        border-right: 1px solid #e0e0e0;
        height: 100vh;
        position: sticky;
        top: 0;
    }

    .section-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--section-title);
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .sidebar .nav-link {
        border-radius: 6px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.25rem;
        color: #417338;
        display: flex;
        align-items: center;
        transition: all 0.3s ease;
    }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: var(--primary-color) !important;
            color: white !important;
        }

        .nav-link i {
            margin-right: 0.75rem;
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
        }

    .main-content {
        padding: 2rem;
        background-color: white;
        min-height: calc(100vh - 56px);
    }

    .welcome-title {
        color: var(--primary-color);
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .welcome-subtitle {
        color: #616161;
        margin-bottom: 2rem;
    }

    .card {
        border: none;
        border-radius: 10px;
        box-shadow: var(--card-shadow);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
        border-left: 4px solid var(--primary-color);
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        }

    .card-title {
        color: var(--primary-color);
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    .card-body {
        padding: 1.5rem;
    }

    .card-text {
        color: #616161;
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--primary-color);
        margin-top: 0.5rem;
    }

    .issue-badge {
        font-size: 0.8rem;
        padding: 0.35rem 0.7rem;
        border-radius: 20px;
    }

    .badge-new {
        background-color: #ffebee;
        color: #d32f2f;
    }

    .badge-resolved {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .bi {
        font-size: 1.2rem;
        margin-right: 0.5rem;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar p-3">
            <div class="position-sticky">
                <h5 class="section-title">QUẢN LÍ TÒA NHÀ</h5>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-controller="Phong" asp-action="Index">
                            <i class="bi bi-door-open"></i> Phòng
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-controller="SuCo_QL" asp-action="Index">
                            <i class="bi bi-tools"></i> Sự cố
                        </a>
                    </li>
                </ul>

                <h5 class="section-title mt-4">HỖ TRỢ</h5>
                <ul class="nav flex-column">
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-controller="KhachThue" asp-action="DanhSach">
                            <i class="bi bi-people"></i> Khách thuê
                        </a>
                    </li>
                    <li class="nav-item mb-2">
                        <a class="nav-link" asp-controller="HopDong" asp-action="DanhSach">
                            <i class="bi bi-file-text"></i> Hợp đồng
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
            <h2 class="welcome-title"><i class="bi bi-house-gear"></i> Chào mừng Quản lý!</h2>
            <p class="welcome-subtitle">Trang tổng quan giúp bạn kiểm soát tình trạng phòng, sự cố và hỗ trợ khách thuê</p>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-exclamation-triangle"></i> Sự cố mới <span class="issue-badge badge-new ms-2">3 mới</span></h5>
                            <p class="card-text">Danh sách sự cố chưa xử lý</p>
                            <div class="stat-value">5</div>
                            <a asp-controller="SuCo_QL" asp-action="Index" class="btn btn-sm btn-outline-success mt-2">Xem chi tiết</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-check-circle"></i> Sự cố đã hoàn thành <span class="issue-badge badge-resolved ms-2">Hôm nay: 2</span></h5>
                            <p class="card-text">Danh sách sự cố đã được xử lý</p>
                            <div class="stat-value">12</div>
                            <a asp-controller="SuCo_QL" asp-action="Index" class="btn btn-sm btn-outline-success mt-2">Xem chi tiết</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-door-open"></i> Phòng trống</h5>
                            <p class="card-text">Số phòng chưa có người thuê</p>
                            <div class="stat-value">8</div>
                            <a asp-controller="Phong" asp-action="Index" class="btn btn-sm btn-outline-success mt-2">Xem danh sách</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-people"></i> Khách thuê</h5>
                            <p class="card-text">Tổng số khách đang thuê</p>
                            <div class="stat-value">45</div>
                            <a asp-controller="KhachThue" asp-action="DanhSach" class="btn btn-sm btn-outline-success mt-2">Xem danh sách</a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

@* <!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css"> *@