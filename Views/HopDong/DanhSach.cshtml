@model QuanLiPhongTro.Models.HopDongFilterViewModel
@using QuanLiPhongTro.Helpers
@{
    ViewData["Title"] = "Danh sách hợp đồng";
    var toaNhas = ViewBag.ToaNhas as List<string>;
    var phongs = ViewBag.Phongs as List<string>;
    var mainColor = "#248F55";
    var hoverColor = "#1E7A4B";
}

<style>
    .btn-main {
        background-color: @mainColor;
        border-color: @mainColor;
        color: white;
    }

        .btn-main:hover {
            background-color: @hoverColor;
            border-color: @hoverColor;
        }

    .badge-success {
        background-color: @mainColor !important;
    }

    .form-select, .form-control {
        border-radius: 8px;
    }

    .table th {
        background-color: #E9F4ED;
        color: #2F4F4F;
    }

    .table td {
        vertical-align: middle;
    }

    .page-link {
        color: @mainColor;
    }

    .page-item.active .page-link {
        background-color: @mainColor;
        border-color: @mainColor;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        border-radius: 5px;
    }
</style>

<div class="container-fluid">
    <h4 class="mb-4 fw-bold" style="color:@mainColor">@ViewData["Title"]</h4>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- Form lọc -->
    <form method="get" asp-action="DanhSach" class="d-flex flex-wrap gap-2 mb-3 p-3 shadow-sm border rounded bg-light">
        <select class="form-select w-auto" name="ToaNha">
            <option value="">Tòa nhà</option>
            @foreach (var toa in toaNhas)
            {
                <option value="@toa" selected="@(toa == Model.ToaNha)"> @toa </option>
            }
        </select>

        <select class="form-select w-auto" name="Phong">
            <option value="">Phòng</option>
            @foreach (var phong in phongs)
            {
                <option value="@phong" selected="@(phong == Model.Phong)"> @phong </option>
            }
        </select>

        <select class="form-select w-auto" name="TrangThai">
            <option value="">Tất cả trạng thái</option>
            <option value="false" selected="@(Model.TrangThai == false)">Đang thuê</option>
            <option value="true" selected="@(Model.TrangThai == true)">Đã trả phòng</option>
        </select>

        <input type="month" class="form-control w-auto" name="Thang" value="@(Model.Thang?.ToString("yyyy-MM"))" />

        <input type="text" class="form-control w-auto" name="TuKhoa" value="@Model.TuKhoa" placeholder="Tìm theo tên, SĐT..." />

        <button type="submit" class="btn btn-main"><i class="fas fa-search"></i> Lọc</button>

        <div class="ms-auto d-flex gap-2">
            <a asp-action="Them" class="btn btn-success" title="Thêm hợp đồng"><i class="fas fa-plus"></i></a>
        </div>
    </form>

    <!-- Bảng hợp đồng -->
    <div class="table-responsive shadow-sm border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="text-center">
                <tr>
                    <th>#</th>
                    <th>Thao tác</th>
                    <th>Người thuê</th>
                    <th>Tòa nhà</th>
                    <th>Phòng</th>
                    <th>Tiền cọc</th>
                    <th>Ngày bắt đầu</th>
                    <th>Ngày kết thúc</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @{
                    int stt = (Model.Page - 1) * Model.PageSize + 1;
                }
                @foreach (var item in Model.HopDongs)
                {
                    <tr>
                        <td>@(stt++)</td>
                        <td>
                            <a asp-action="Sua" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Sửa"><i class="fas fa-edit"></i></a>
                            <form asp-action="Xoa" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc muốn xóa hợp đồng này?')" title="Xóa">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </td>
                        <td>@item.User?.UserName</td>
                        <td>@item.Phong?.ToaNha?.TenToa</td>
                        <td>@item.Phong?.TenPhong</td>
                        <td>@item.TienCoc.ToString("N0") đ</td>
                        <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                        <td>@(item.NgayKetThuc.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>
                            @if (!item.DaTra)
                            {
                                <span class="badge bg-success">Đang thuê</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Đã trả phòng</span>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.HopDongs.Any())
                {
                    <tr>
                        <td colspan="9" class="text-muted text-center py-3">Không có hợp đồng nào!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    <div class="mt-3 d-flex justify-content-between align-items-center">
        <div class="text-muted">Tổng: @Model.TotalRecords bản ghi</div>
        <ul class="pagination mb-0">
            @{
                var totalPages = (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize);
                var currentPage = Model.Page;
            }

            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="DanhSach" asp-route-Page="@(currentPage - 1)">‹</a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="DanhSach" asp-route-Page="@i">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="DanhSach" asp-route-Page="@(currentPage + 1)">›</a>
            </li>
        </ul>
    </div>
</div>
