@model IEnumerable<QuanLiPhongTro.Models.SuCo>

@{
    ViewData["Title"] = "Sự cố đã báo cáo";
}

<style>
    .issue-container {
        max-width: 1000px;
        margin: 2rem auto;
        padding: 2rem;
        background: white;
        border-radius: 8px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
    }

    .issue-title {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: #2e7d32;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #a5d6a7;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1.5rem;
    }

    .table thead th {
        background-color: #4caf50;
        color: white;
        padding: 12px 15px;
        text-align: left;
    }

    .table tbody tr {
        border-bottom: 1px solid #e0e0e0;
        transition: background-color 0.3s;
    }

    .table tbody tr:nth-child(even) {
        background-color: #f5f5f5;
    }

    .table tbody tr:hover {
        background-color: #e8f5e9;
    }

    .table td {
        padding: 12px 15px;
    }

    .status-resolved {
        color: #2e7d32;
        font-weight: 500;
    }

    .status-pending {
        color: #ff6f00;
        font-weight: 500;
    }

    .no-issues {
        text-align: center;
        padding: 2rem;
        color: #616161;
        font-size: 1.1rem;
    }
</style>

<div class="issue-container">
    <h2 class="issue-title">@ViewData["Title"]</h2>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Phòng</th>
                        <th>Ngày báo cáo</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var suCo in Model)
                    {
                        <tr>
                            <td>@suCo.Phong.TenPhong</td>
                            <td>@suCo.NgayBaoCao.ToString("dd/MM/yyyy")</td>
                            <td>@suCo.MoTa</td>
                            <td>
                                @if (suCo.DaGiaiQuyet)
                                {
                                    <span class="status-resolved">
                                        <i class="fas fa-check-circle"></i> Đã giải quyết
                                    </span>
                                }
                                else
                                {
                                    <span class="status-pending">
                                        <i class="fas fa-clock"></i> Chưa giải quyết
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="no-issues">
            <i class="far fa-check-circle fa-3x mb-3" style="color: #a5d6a7;"></i>
            <p>Bạn chưa báo cáo sự cố nào</p>
        </div>
    }
</div>

@section Scripts {
    <!-- Thêm Font Awesome cho icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
}