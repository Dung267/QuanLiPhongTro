@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng Nhập";
}

<style>
    .login-container {
        display: flex;
        min-height: 100vh;
        background-color: #f8f9fa;
    }

    .login-form-section {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: white;
    }

    .login-image-section {
        flex: 1;
        background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('https://images.unsplash.com/photo-1469474968028-56623f02e42e?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
    }

    .login-form {
        max-width: 400px;
        width: 100%;
    }

    .form-floating:focus-within {
        z-index: 2;
    }

    .login-title {
        font-size: 2rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: #2e7d32; /* Màu xanh lá đậm cho tiêu đề */
    }

    /* Màu cho input fields */
    .form-control {
        border-color: #a5d6a7; /* Màu xanh lá nhạt cho viền input */
    }

        .form-control:focus {
            border-color: #4caf50; /* Màu xanh lá đậm hơn khi focus */
            box-shadow: 0 0 0 0.25rem rgba(76, 175, 80, 0.25); /* Hiệu ứng shadow màu xanh lá */
        }

    /* Màu cho label */
    .form-label {
        color: #2e7d32; /* Màu xanh lá đậm cho label */
    }

    /* Màu cho nút đăng nhập */
    .btn-login {
        background-color: #4caf50; /* Màu xanh lá đậm */
        border: none;
        padding: 0.75rem;
        font-size: 1.1rem;
        transition: all 0.3s;
    }

        .btn-login:hover {
            background-color: #388e3c; /* Màu xanh lá đậm hơn khi hover */
        }

    /* Màu cho liên kết */
    a {
        color: #2e7d32; /* Màu xanh lá đậm cho liên kết */
    }

        a:hover {
            color: #1b5e20; /* Màu xanh lá đậm hơn khi hover */
        }

    /* Màu cho checkbox */
    .form-check-input:checked {
        background-color: #4caf50;
        border-color: #4caf50;
    }

    .image-content {
        padding: 2rem;
    }

    .image-title {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .image-subtitle {
        font-size: 1.2rem;
        opacity: 0.9;
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 1.5rem 0;
        color: #6c757d;
    }

        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            border-bottom: 1px solid #dee2e6;
        }

        .divider::before {
            margin-right: 0.5rem;
        }

        .divider::after {
            margin-left: 0.5rem;
        }
</style>

<div class="login-container">
    <!-- Left side - Login Form -->
    <div class="login-form-section">
        <div class="login-form">
            <h1 class="login-title">@ViewData["Title"]</h1>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mb-4">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe">Ghi nhớ đăng nhập</label>
                    </div>
                    <div>
                        <a id="forgot-password" asp-page="./ForgotPassword">Quên mật khẩu?</a>
                    </div>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary btn-login mb-3">Đăng nhập</button>

                <div class="text-center mt-3">
                    <p>Chưa có tài khoản? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a></p>
                </div>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="divider">HOẶC</div>

                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div class="d-grid gap-2">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-success" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                    Đăng nhập với @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                }
            </form>
        </div>
    </div>

    <!-- Right side - Theme Image -->
    <div class="login-image-section">
        <div class="image-content">
            <h2 class="image-title">Chào mừng trở lại!</h2>
            <p class="image-subtitle">Đăng nhập để truy cập vào hệ thống và khám phá những tính năng tuyệt vời</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}